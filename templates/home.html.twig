{% extends 'base.html.twig' %}

{% block title %}InnovaDev - Inicio{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('home') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('home') }}
{% endblock %}

{% block body %}
    <div class="content">
        <div class="hero">
            <div class="hero-text">
                <h1>InnovaDev: Construyendo el futuro de la Web</h1>
                <p>Jóvenes desarrolladores especializados en PHP, Symfony, JavaScript y apasionados por la IA y el Big Data.</p>
            </div>

            <div class="hero-buttons">
                <a href="{{ path('projects') }}" class="btn-primary">Ver Proyectos →</a>
                <a href="{{ path('services') }}" class="btn-secondary">Nuestros Servicios</a>
            </div>
        </div>

        <div class="main-section">
            <div class="about">
                <h2>Sobre Nosotros</h2>

                <p>
                    En InnovaDev somos tres desarrolladores web apasionados por la tecnología, especializados en el
                    desarrollo de aplicaciones web avanzadas combinadas con Inteligencia Artificial y Big Data.
                    Nuestro objetivo es transformar ideas en productos digitales inteligentes que aporten valor real
                    a empresas y usuarios.
                </p>

                <div class="about-image">
                    <div class="team-avatar">
                        <img src="{{ asset('images/avatar_fr.png') }}" alt="Fran Requena">
                        <p>Fran Requena</p>
                    </div>
                    <div class="team-avatar">
                        <img src="{{ asset('images/avatar_prueba.png') }}" alt="Rodrigo Ceacero">
                        <p>Rodrigo Ceacero</p>
                    </div>
                    <div class="team-avatar">
                        <img src="{{ asset('images/avatar_fc.png') }}" alt="Fran Cañera">
                        <p>Fran Cañera</p>
                    </div>
                </div>
            </div>
            <div class="skills">
                <h2>Habilidades y Tecnologías</h2>

                <div class="web-dev">
                    <h3>Desarrollo Web</h3>

                    <p> Diseñamos y desarrollamos aplicaciones web robustas, seguras y escalables,aplicando buenas prácticas, arquitectura limpia y tecnologías modernas tanto en frontend como en backend.</p>

                    <ul>
                        <li>PHP</li>
                        <li>Symfony</li>
                        <li>JavaScript</li>
                        <li>HTML5 & CSS3/Sass</li>
                        <li>SQL</li>
                    </ul>
                </div>

                <div class="ia-bd">
                    <h3>Inteligencia Artificial y Big Data</h3>

                    <p>Integramos soluciones basadas en datos e Inteligencia Artificial para mejorar la toma de decisiones, automatizar procesos y extraer valor de grandes volúmenes de información.</p>

                    <ul>
                        <li>Machine Learning</li>
                        <li>Data Analysis</li>
                        <li>Python</li>
                        <li>TensorFlow</li>
                    </ul>
                </div>
            </div>
            <div class="ft-projects">
                <h2>Proyectos Destacados</h2>

                {# TODO: Aquí puedes agregar una lista o galería de proyectos destacados junto con las respectivas tecnologías utilizadas #}
            </div>
        </div>
    </div>
{% endblock %}