<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}{{ 'site.title'|trans }}{% endblock %}
        </title>
        <link rel="icon" href="{{ asset('images/id.png') }}">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <div class="wrapper">
            <nav class="navbar">
                <a href="{{ path('home', {'_locale': app.request.locale}) }}" class="logo">
                    <span class="logo-id">ID</span>
                    <span class="logo-text">InnovaDev</span>
                </a>

                <section class="menu-toggle">
                    <label for="menu-checkbox">
                        <span>&#9776;</span>
                    </label>
                    <input type="checkbox" id="menu-checkbox">
                </section>

                <div class="nav-links">
                    <a href="{{ path('home', {'_locale': app.request.locale}) }}"
                       {% if app.request.get('_route') matches '/^home/' %}class="active"{% endif %}>
                        {{ 'nav.home'|trans }}
                    </a>

                    <a href="{{ path('about', {'_locale': app.request.locale}) }}"
                       {% if app.request.get('_route') matches '/^about/' %}class="active"{% endif %}>
                        {{ 'nav.about'|trans }}
                    </a>

                    <a href="{{ path('projects', {'_locale': app.request.locale}) }}"
                       {% if app.request.get('_route') matches '/^projects/' %}class="active"{% endif %}>
                        {{ 'nav.projects'|trans }}
                    </a>

                    <a href="{{ path('services', {'_locale': app.request.locale}) }}"
                       {% if app.request.get('_route') matches '/^services/' %}class="active"{% endif %}>
                        {{ 'nav.services'|trans }}
                    </a>

                    <a href="{{ path('contact', {'_locale': app.request.locale}) }}"
                       {% if app.request.get('_route') matches '/^contact/' %}class="active"{% endif %}>
                        {{ 'nav.contact'|trans }}
                    </a>
                </div>

                <div class="lang-switch">
                    <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'es'})) }}">ES</a> |
                    <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}">EN</a>
                </div>
            </nav>

            <div class="content">
                {% block body %}{% endblock %}
            </div>

            <footer class="footer">
                <p class="footer-text">
                    &copy; {{ "now"|date("Y") }}
                    <a href="{{ path('home', {'_locale': app.request.locale}) }}">InnovaDev</a>.
                    {{ 'footer.rights'|trans }}
                </p>

                <nav class="footer-links">
                    <a href="{{ path('legal_notice', {'_locale': app.request.locale}) }}">
                        {{ 'footer.legal'|trans }}
                    </a>
                    <a href="{{ path('privacy_policy', {'_locale': app.request.locale}) }}">
                        {{ 'footer.privacy'|trans }}
                    </a>
                    <a href="{{ path('cookies_policy', {'_locale': app.request.locale}) }}">
                        {{ 'footer.cookies'|trans }}
                    </a>
                </nav>
            </footer>
        </div>
    </body>
</html>